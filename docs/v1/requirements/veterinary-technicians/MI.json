{"jsonapi":{"version":"1.1"},"data":{"type":"requirements","id":"veterinary-technicians-MI","attributes":{"state":"MI","state_name":"Michigan","profession":"veterinary-technicians","board_name":"Michigan Board of Veterinary Medicine (LARA)","board_url":"https://www.michigan.gov/lara/bureau-list/bpl/health/hp-lic-health-prof/veterinary-medicine","rules":[{"license":"Veterinary Technician","credits_required":15,"unit":"hours","period_months":36,"accepted_credit_types":"Board-approved courses or programs (the Department does not pre-approve courses)","renewal_url":"https://www.michigan.gov/miplus","renewal_fee_usd":124.8,"reporting":"attestation","audit_note":"Random audit after each renewal period; keep records 4 years.","topics":[],"notes":"Licensed veterinary technicians renew every 3 years. Min 10 h scientific; min 5 h in person or live synchronous.","source_url":"https://www.michigan.gov/lara/-/media/Project/Websites/lara/bpl/Veterinary/Licensing-Info-and-Forms/Veterinary-Technician-Licensing-Guide-FAQ-12626.pdf","rule_quote":"…15 hours of board-approved continuing education within the 3-year period immediately preceding the application for relicensure…","rule_quote_url":"https://www.michigan.gov/lara/-/media/Project/Websites/lara/bpl/Veterinary/Licensing-Info-and-Forms/Veterinary-Technician-Licensing-Guide-FAQ-12626.pdf#page=3","rule_quote_checked":"2026-11-25","checked_at":"2026-10-28"}],"medcehub_url":"https://medcehub.com/vet-tech-ce-requirements/michigan"},"links":{"self":"https://api.medcehub.com/v1/requirements/veterinary-technicians/MI.json","medcehub":"https://medcehub.com/vet-tech-ce-requirements/michigan"}},"links":{"self":"https://api.medcehub.com/v1/requirements/veterinary-technicians/MI.json"}}