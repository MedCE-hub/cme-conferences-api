{"jsonapi":{"version":"1.1"},"data":{"type":"requirements","id":"veterinary-technicians-KS","attributes":{"state":"KS","state_name":"Kansas","profession":"veterinary-technicians","board_name":"Kansas Board of Veterinary Examiners","board_url":"https://kbve.kansas.gov/","rules":[{"license":"Registered Veterinary Technician","credits_required":4,"unit":"hours","period_months":12,"no_ce_required":false,"cycle_basis":"fixed_date","fixed_deadline":"04-30","renewal_url":"https://kbve.kansas.gov/renewals/","renewal_fee_usd":25,"reporting":"attestation","topics":[],"notes":"Registration renews every year (registration year May 1 - April 30); on the renewal form the technician attests to at least 4 hours of CE in the past registration year. The Board's power to renew technician registrations is K.S.A. 47-821; the regulation section setting the 4 hours was not located, so the figure is taken from the Board's 2026-2027 renewal form.","legal_basis":"K.S.A. 47-821, items (15)-(16); KBVE renewal form 2026-2027","legal_basis_url":"https://www.kslegislature.gov/b2025_26/laws/047_000_0000_chapter/047_008_0000_article/047_008_0021_section/047_008_0021_k/","source_url":"https://kbve.kansas.gov/wp-content/uploads/2023/04/Veterinary-Technician-Reg.-Renewal-2026-2027.pdf","rule_quote":"I have completed a minimum of 4 hours of continuing education during the registration year May 1, 2025 through April 30, 2026.","rule_quote_url":"https://kbve.kansas.gov/wp-content/uploads/2023/04/Veterinary-Technician-Reg.-Renewal-2026-2027.pdf#page=1","checked_at":"2026-11-25","rule_quote_checked":"2026-11-25"}],"medcehub_url":"https://medcehub.com/vet-tech-ce-requirements/kansas"},"links":{"self":"https://api.medcehub.com/v1/requirements/veterinary-technicians/KS.json","medcehub":"https://medcehub.com/vet-tech-ce-requirements/kansas"}},"links":{"self":"https://api.medcehub.com/v1/requirements/veterinary-technicians/KS.json"}}